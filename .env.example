# 环境变量模板：复制为 .env 后按实际环境修改

# 服务端监听地址与端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# CORS 允许的前端地址（本地开发用 http://localhost:5173，线上填站点域名）
FRONTEND_ORIGIN=http://localhost:5173

# 博客 .md 文件保存目录（绝对路径）
DOC_PATH=/path/to/doc

# 图片文件保存目录（绝对路径）
IMAGE_PATH=/path/to/images

# PostgreSQL 连接
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=？？？
PGUSER=？？？
PGPASSWORD=？？？
