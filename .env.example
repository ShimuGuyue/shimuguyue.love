# 环境变量模板：复制为 .env 后按实际环境修改

# 服务端监听地址与端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 前端构建输出目录（vite 构建时读取，默认 dist）
BUILD_DIR=dist

# CORS 允许的前端地址（本地开发用 http://localhost:5173，线上填站点域名）
FRONTEND_ORIGIN=http://localhost:5173

# 文件根目录（绝对路径）
# 文档文件在    $FILE_PATH/doc/
#     博客文件在               blog/
# 图片文件在    $FILE_PATH/image/
# README 仓库在 $FILE_PATH/README/
FILE_PATH=/path/to/files

# GitHub 用户名（pull-readme.sh 自动拉取 README 用）
GITHUB_USER=ShimuGuyue

# PostgreSQL 连接
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=？？？
PGUSER=？？？
PGPASSWORD=？？？
